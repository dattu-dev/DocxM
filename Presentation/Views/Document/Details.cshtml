@model DocumentDetailsViewModel

@{
    ViewData["Title"] = Model.Document.Title;
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <a asp-action="Index" class="text-decoration-none">&larr; Quay lại danh sách</a>
        <h1 class="display-6 mt-2 mb-0">@Model.Document.Title</h1>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Download" asp-route-id="@Model.Document.DocumentId">Tải file gốc</a>
        <form asp-action="ReIndex" asp-route-id="@Model.Document.DocumentId" method="post"
              onsubmit="return confirm('Xử lý lại tài liệu này?');">
            <button class="btn btn-outline-warning" type="submit">Xử lý lại</button>
        </form>
        <form asp-action="Delete" asp-route-id="@Model.Document.DocumentId" method="post"
              onsubmit="return confirm('Xóa tài liệu này?');">
            <button class="btn btn-outline-danger" type="submit">Xóa</button>
        </form>
    </div>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-semibold">Thông tin tài liệu</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">File</dt>
                    <dd class="col-sm-7">@Model.Document.OriginalFileName</dd>

                    <dt class="col-sm-5">Môn học</dt>
                    <dd class="col-sm-7">@Model.Document.SubjectName</dd>

                    <dt class="col-sm-5">Chương</dt>
                    <dd class="col-sm-7">@(Model.Document.ChapterTitle ?? "Không gắn chương")</dd>

                    <dt class="col-sm-5">Người upload</dt>
                    <dd class="col-sm-7">@(Model.Document.UploadedByFullName ?? "Không xác định")</dd>

                    <dt class="col-sm-5">Trạng thái</dt>
                    <dd class="col-sm-7">
                        <span class="badge @GetStatusBadge(Model.Document.ProcessingStatus)">
                            @GetStatusLabel(Model.Document.ProcessingStatus)
                        </span>
                    </dd>

                    <dt class="col-sm-5">Số đoạn</dt>
                    <dd class="col-sm-7">@Model.Document.ChunkCount</dd>

                    <dt class="col-sm-5">Dung lượng</dt>
                    <dd class="col-sm-7">@FormatBytes(Model.Document.FileSizeBytes)</dd>

                    <dt class="col-sm-5">Ngày tải lên</dt>
                    <dd class="col-sm-7">@Model.Document.UploadedAt.ToLocalTime().ToString("dd/MM/yyyy")</dd>
                </dl>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Document.Description))
        {
            <div class="card border-0 shadow-sm mt-4">
                <div class="card-header bg-white fw-semibold">Mô tả</div>
                <div class="card-body">
                    <p class="mb-0">@Model.Document.Description</p>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-semibold">Nội dung đã chia đoạn</div>
            <div class="card-body">
                @if (Model.Document.Chunks.Count == 0)
                {
                    <div class="alert alert-warning mb-0">
                        Chưa có đoạn nào. File có thể không có nội dung trích xuất được hoặc quá trình xử lý bị lỗi.
                    </div>
                }
                else
                {
                    <div class="accordion" id="chunkAccordion">
                        @foreach (var chunk in Model.Document.Chunks)
                        {
                            string itemId = $"chunk-{chunk.DocumentChunkId}";
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="heading-@itemId">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                            data-bs-target="#collapse-@itemId" aria-expanded="false"
                                            aria-controls="collapse-@itemId">
                                        Đoạn @chunk.ChunkIndex - @(chunk.TokenCount ?? 0) token ước tính
                                        @if (!string.IsNullOrWhiteSpace(chunk.VectorId))
                                        {
                                            <span class="ms-2 small text-muted">VectorId: @chunk.VectorId</span>
                                        }
                                    </button>
                                </h2>
                                <div id="collapse-@itemId" class="accordion-collapse collapse"
                                     aria-labelledby="heading-@itemId" data-bs-parent="#chunkAccordion">
                                    <div class="accordion-body">
                                        <pre class="chunk-content mb-0">@chunk.Content</pre>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@functions {
    private static string FormatBytes(long bytes)
    {
        string[] units = { "B", "KB", "MB", "GB" };
        double size = bytes;
        int unit = 0;

        while (size >= 1024 && unit < units.Length - 1)
        {
            size /= 1024;
            unit++;
        }

        return $"{size:0.##} {units[unit]}";
    }

    private static string GetStatusBadge(string status)
    {
        return status switch
        {
            "Indexed" => "text-bg-success",
            "Failed" => "text-bg-danger",
            _ => "text-bg-secondary"
        };
    }

    private static string GetStatusLabel(string status)
    {
        return status switch
        {
            "Indexed" => "Đã xử lý",
            "Failed" => "Lỗi xử lý",
            "Uploaded" => "Đã tải lên",
            _ => status
        };
    }
}

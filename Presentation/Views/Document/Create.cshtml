@model DocumentUploadViewModel

@{
    ViewData["Title"] = "Tải tài liệu lên";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="mb-4">
            <a asp-action="Index" class="text-decoration-none">&larr; Quay lại danh sách</a>
            <h1 class="display-6 mt-2">Tải tài liệu lên</h1>
            <p class="text-muted mb-0">
                Hỗ trợ PDF, DOCX và PPTX. Hệ thống sẽ lưu file, trích xuất nội dung, chia đoạn và sinh embedding tự động.
            </p>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="SubjectId" class="form-label"></label>
                        <select asp-for="SubjectId" asp-items="Model.Subjects" class="form-select"></select>
                        <span asp-validation-for="SubjectId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ChapterId" class="form-label"></label>
                        <select asp-for="ChapterId" asp-items="Model.Chapters" class="form-select"></select>
                        <span asp-validation-for="ChapterId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title" class="form-control" placeholder="VD: Slide tổng quan ASP.NET Core MVC" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Ghi chú ngắn về tài liệu"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="File" class="form-label"></label>
                        <input asp-for="File" class="form-control" type="file" accept=".pdf,.docx,.pptx" />
                        <div class="form-text">Dung lượng tối đa 100 MB.</div>
                        <span asp-validation-for="File" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                        <button type="submit" class="btn btn-primary">Tải lên và lập chỉ mục</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

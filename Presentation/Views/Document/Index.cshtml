@model DocumentIndexViewModel

@{
    ViewData["Title"] = "Quản lý tài liệu";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h1 class="display-6 mb-0">Quản lý tài liệu</h1>
    </div>
    <a class="btn btn-primary" asp-action="Create">Tải tài liệu lên</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<form method="get" class="card card-body border-0 shadow-sm mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label asp-for="SubjectId" class="form-label">Môn học</label>
            <select asp-for="SubjectId"
                    asp-items="Model.Subjects"
                    class="form-select"
                    onchange="document.getElementById('ChapterId').value = ''; this.form.submit();"></select>
        </div>
        <div class="col-md-3">
            <label asp-for="ChapterId" class="form-label">Chương</label>
            <select asp-for="ChapterId"
                    asp-items="Model.Chapters"
                    class="form-select"
                    disabled="@(!Model.SubjectId.HasValue)"
                    onchange="this.form.submit();"></select>
        </div>
        <div class="col-md-4">
            <label asp-for="SearchTerm" class="form-label">Tìm kiếm</label>
            <input asp-for="SearchTerm" class="form-control" placeholder="Tiêu đề, file, mô tả" />
        </div>
        <div class="col-md-1 d-grid">
            <button type="submit" class="btn btn-dark">Lọc</button>
        </div>
    </div>
</form>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle mb-0 documents-table">
            <colgroup>
                <col class="documents-col-title" />
                <col class="documents-col-subject" />
                <col class="documents-col-user" />
                <col class="documents-col-count" />
                <col class="documents-col-date" />
                <col class="documents-col-actions" />
            </colgroup>
            <thead class="table-light">
                <tr>
                    <th>Tài liệu</th>
                    <th>Môn / chương</th>
                    <th>Người upload</th>
                    <th class="text-center">Số đoạn</th>
                    <th>Ngày tải lên</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Documents.Count == 0)
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-5">
                        Chưa có tài liệu nào. Hãy tải PDF, DOCX hoặc PPTX đầu tiên.
                    </td>
                </tr>
            }
            else
            {
                foreach (var document in Model.Documents)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@document.Title</div>
                            <div class="small text-muted">@document.OriginalFileName</div>
                            <div class="small text-muted">@document.FileExtension.ToUpperInvariant() - @FormatBytes(document.FileSizeBytes)</div>
                        </td>
                        <td>
                            <div>@document.SubjectName</div>
                            <div class="small text-muted">@(document.ChapterTitle ?? "Không gắn chương")</div>
                        </td>
                        <td>@(document.UploadedByFullName ?? "Không xác định")</td>
                        <td class="text-center">@document.ChunkCount</td>
                        <td>@document.UploadedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                        <td class="text-end">
                            <div class="document-actions">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@document.DocumentId">Chi tiết</a>
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Download" asp-route-id="@document.DocumentId">Tải file</a>
                                <form asp-action="ReIndex" asp-route-id="@document.DocumentId" method="post"
                                      onsubmit="return confirm('Xử lý lại tài liệu này?');">
                                    <button class="btn btn-sm btn-outline-warning btn-reindex" type="submit">Xử lý lại</button>
                                </form>
                                <form asp-action="Delete" asp-route-id="@document.DocumentId" method="post"
                                      onsubmit="return confirm('Xóa tài liệu này?');">
                                    <button class="btn btn-sm btn-outline-danger" type="submit">Xóa</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

@functions {
    private static string FormatBytes(long bytes)
    {
        string[] units = { "B", "KB", "MB", "GB" };
        double size = bytes;
        int unit = 0;

        while (size >= 1024 && unit < units.Length - 1)
        {
            size /= 1024;
            unit++;
        }

        return $"{size:0.##} {units[unit]}";
    }
}

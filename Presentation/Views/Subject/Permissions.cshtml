@model SubjectPermissionsViewModel

@{
    ViewData["Title"] = "Quản lý sinh viên";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <a asp-action="Details" asp-route-id="@Model.SubjectId" class="text-decoration-none">&larr; Quay lại môn học</a>
        <h1 class="display-6 mt-2 mb-0">Quản lý sinh viên</h1>
        <p class="text-muted mb-0">@Model.SubjectName</p>
    </div>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white fw-semibold">Cấp quyền xem môn học</div>
    <div class="card-body">
        <form asp-action="GrantPermission" method="post" class="row g-3 align-items-end">
            <input asp-for="SubjectId" type="hidden" />

            <div class="col-md-8">
                <label asp-for="StudentEmail" class="form-label"></label>
                <input asp-for="StudentEmail" class="form-control" autocomplete="off" />
                <span asp-validation-for="StudentEmail" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <button class="btn btn-primary w-100" type="submit">Cấp quyền</button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white fw-semibold">Sinh viên có quyền xem</div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Sinh viên</th>
                    <th>Email</th>
                    <th>Ngày cấp quyền</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Students.Count == 0)
            {
                <tr>
                    <td colspan="4" class="text-center text-muted py-5">
                        Chưa có sinh viên nào được cấp quyền.
                    </td>
                </tr>
            }
            else
            {
                foreach (var student in Model.Students)
                {
                    <tr>
                        <td class="fw-semibold">@student.FullName</td>
                        <td>@student.Email</td>
                        <td>@student.GrantedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-end">
                            <form asp-action="RevokePermission"
                                  method="post"
                                  class="d-inline"
                                  onsubmit="return confirm('Thu hồi quyền xem môn học của sinh viên này?');">
                                <input name="subjectId" type="hidden" value="@Model.SubjectId" />
                                <input name="studentUserId" type="hidden" value="@student.StudentUserId" />
                                <button class="btn btn-sm btn-outline-danger" type="submit">Thu hồi</button>
                            </form>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

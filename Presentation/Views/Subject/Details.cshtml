@model SubjectDetailsViewModel

@{
    ViewData["Title"] = Model.Subject.Name;
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <a asp-action="Index" class="text-decoration-none">&larr; Quay lại danh sách môn học</a>
        <h1 class="display-6 mt-2 mb-0">@Model.Subject.Name</h1>
        <p class="text-muted mb-0">@(Model.Subject.Description ?? "Chưa có mô tả")</p>
    </div>
    @if (User.IsInRole(UserRoles.Instructor))
    {
        <div class="d-flex gap-2">
            <a class="btn btn-outline-primary" asp-action="Permissions" asp-route-id="@Model.Subject.SubjectId">Quản lý sinh viên</a>
            <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Subject.SubjectId">Sửa môn học</a>
        </div>
    }
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white fw-semibold">Danh sách chương</div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Chương</th>
                    <th>Mô tả</th>
                    <th>Số tài liệu</th>
                    <th>Ngày tạo</th>
                    @if (User.IsInRole(UserRoles.Instructor))
                    {
                        <th class="text-end">Thao tác</th>
                    }
                </tr>
            </thead>
            <tbody>
            @if (Model.Subject.Chapters.Count == 0)
            {
                <tr>
                    <td colspan="@(User.IsInRole(UserRoles.Instructor) ? 5 : 4)" class="text-center text-muted py-5">
                        Môn học này chưa có chương.
                    </td>
                </tr>
            }
            else
            {
                foreach (var chapter in Model.Subject.Chapters)
                {
                    <tr>
                        <td class="fw-semibold">@chapter.Title</td>
                        <td>@(chapter.Description ?? "Chưa có mô tả")</td>
                        <td>@chapter.DocumentCount</td>
                        <td>@chapter.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        @if (User.IsInRole(UserRoles.Instructor))
                        {
                            <td class="text-end">
                            @if (chapter.DocumentCount == 0)
                            {
                                <form asp-action="DeleteChapter"
                                      asp-route-subjectId="@Model.Subject.SubjectId"
                                      asp-route-chapterId="@chapter.ChapterId"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Xóa chương này?');">
                                    <button class="btn btn-sm btn-outline-danger" type="submit">Xóa</button>
                                </form>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-danger" type="button" disabled
                                        title="Hãy xóa tài liệu trong chương trước.">
                                    Xóa
                                </button>
                            }
                            </td>
                        }
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

@model ChapterFormViewModel

<div class="mb-3">
    <label asp-for="Title" class="form-label"></label>
    <input asp-for="Title" class="form-control" placeholder="VD: Tổng quan ASP.NET Core MVC" />
    <span asp-validation-for="Title" class="text-danger"></span>
</div>

<div class="mb-4">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control" rows="4" placeholder="Mô tả ngắn về chương"></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>
